{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-agent.dev/schemas/forge-capabilities.schema.json",
  "title": "Forge capability catalog",
  "description": "A runtime-neutral catalog. schema_version versions this catalog only; product releases derive from Git tags.",
  "type": "object",
  "required": ["$schema", "schema_version", "release", "capabilities"],
  "properties": {
    "$schema": { "const": "schemas/forge-capabilities.schema.json" },
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "release": { "$ref": "#/$defs/release" },
    "reason_codes": { "type": "array", "items": { "$ref": "#/$defs/reason_code" }, "uniqueItems": true },
    "runtimes": {
      "type": "object",
      "properties": {
        "node": { "$ref": "#/$defs/runtime" },
        "claude": { "$ref": "#/$defs/runtime" },
        "codex": { "$ref": "#/$defs/runtime" }
      },
      "additionalProperties": false
    },
    "capabilities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/capability" } }
  },
  "additionalProperties": false,
  "$defs": {
    "host": { "type": "string", "enum": ["claude", "codex"] },
    "availability": {
      "type": "string",
      "description": "Schema 1.1.0. distributed: projected by the release without demonstrated behavior. demonstrated: requires versioned evidence for the same host. unknown: never available to dispatch; fatal when required by maintenance.",
      "enum": ["implemented", "planned", "conditional", "unavailable", "common", "distributed", "demonstrated", "unknown"]
    },
    "kind": { "type": "string", "enum": ["skill", "agent", "command", "hook", "headless", "mcp", "statusline", "accounts", "app", "runtime"] },
    "classification": { "type": "string", "enum": ["common", "conditional", "unavailable"] },
    "reason_code": { "type": "string", "enum": ["available", "missing", "unsupported", "inconclusive", "permission-denied", "not-selected", "invalid-output", "exit-nonzero", "minimum-version", "capability-observed", "capability-absent"] },
    "relative_path": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.{0,2}(?:/|$))[^\\\\]+$" },
    "evidence": {
      "type": "object",
      "description": "Versioned evidence per host. Allowed only for a host whose status is demonstrated; the audit requires the file to exist inside the checkout.",
      "minProperties": 1,
      "properties": {
        "claude": { "$ref": "#/$defs/relative_path" },
        "codex": { "$ref": "#/$defs/relative_path" }
      },
      "additionalProperties": false
    },
    "capability_probe": {
      "type": "object",
      "description": "Informational host feature probe. Runs only for a selected available runtime, as argv without a shell; never changes ok or required_failures.",
      "required": ["id", "args"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "args": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "expect_output": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "probe": {
      "type": "object",
      "required": ["kind", "path"],
      "properties": {
        "kind": { "const": "filesystem" },
        "path": { "type": "string", "minLength": 1, "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\]+$" }
      },
      "additionalProperties": false
    },
    "hosts": {
      "type": "object",
      "required": ["claude", "codex"],
      "properties": {
        "claude": { "$ref": "#/$defs/availability" },
        "codex": { "$ref": "#/$defs/availability" }
      },
      "additionalProperties": false
    },
    "platforms": {
      "type": "object",
      "required": ["macos", "windows", "linux"],
      "properties": {
        "macos": { "$ref": "#/$defs/availability" },
        "windows": { "$ref": "#/$defs/availability" },
        "linux": { "$ref": "#/$defs/availability" }
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": ["capability_id", "kind", "owner", "required", "hosts", "probe"],
      "properties": {
        "capability_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "kind": { "$ref": "#/$defs/kind" },
        "owner": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "required": { "type": "boolean" },
        "hosts": { "$ref": "#/$defs/hosts" },
        "probe": { "$ref": "#/$defs/probe" },
        "platforms": { "$ref": "#/$defs/platforms" },
        "classification": { "$ref": "#/$defs/classification" },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "required": ["product_version_source", "adapters"],
      "properties": {
        "product_version_source": { "const": "git-tag-release-workflow" },
        "adapters": {
          "type": "object",
          "required": ["claude", "codex"],
          "properties": {
            "claude": { "$ref": "#/$defs/adapter" },
            "codex": { "$ref": "#/$defs/adapter" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "adapter": {
      "type": "object",
      "required": ["optional", "host"],
      "properties": {
        "optional": { "const": true },
        "host": { "$ref": "#/$defs/host" }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["required", "probe"],
      "properties": {
        "required": { "type": "boolean" },
        "minimum_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "probe": { "$ref": "#/$defs/runtime_probe" },
        "platforms": { "$ref": "#/$defs/platforms" },
        "capability_probes": { "type": "array", "items": { "$ref": "#/$defs/capability_probe" } }
      },
      "additionalProperties": false
    },
    "runtime_probe": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["node", "cli"] },
        "command": { "type": "string", "minLength": 1 },
        "version_args": { "type": "array", "items": { "type": "string" } },
        "behavior_args": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
