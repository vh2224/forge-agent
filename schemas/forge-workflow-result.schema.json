{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-agent.dev/schemas/forge-workflow-result.schema.json",
  "title": "Forge provider-neutral orchestration result",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "operation", "outcome", "reason_code"],
  "properties": {
    "protocol_version": { "const": "1.0.0" },
    "operation": { "enum": ["init", "status", "next", "complete", "handoff"] },
    "outcome": { "enum": ["needs_input", "completed", "blocked", "no_work", "failed"] },
    "reason_code": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "milestone": { "type": ["string", "null"] },
    "unit": { "$ref": "#/$defs/unit" },
    "state": { "type": ["object", "null"] },
    "events": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "boundary": { "type": ["object", "null"] },
    "details": { "type": "object", "additionalProperties": true },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "unit": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["type", "id", "key"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 }
      }
    }
  }
}
