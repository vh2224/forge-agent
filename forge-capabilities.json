{
  "$schema": "schemas/forge-capabilities.schema.json",
  "schema_version": "1.1.0",
  "release": {
    "product_version_source": "git-tag-release-workflow",
    "adapters": {
      "claude": { "optional": true, "host": "claude" },
      "codex": { "optional": true, "host": "codex" }
    }
  },
  "reason_codes": ["available", "missing", "unsupported", "inconclusive", "permission-denied", "not-selected", "invalid-output", "exit-nonzero", "minimum-version", "capability-observed", "capability-absent"],
  "runtimes": {
    "node": {
      "required": true,
      "minimum_version": "18.0.0",
      "probe": { "kind": "node" },
      "platforms": { "macos": "common", "windows": "common", "linux": "common" }
    },
    "claude": {
      "required": false,
      "probe": { "kind": "cli", "command": "claude", "version_args": ["--version"], "behavior_args": ["--help"] },
      "platforms": { "macos": "common", "windows": "common", "linux": "common" },
      "capability_probes": [
        { "id": "claude-stream-json", "args": ["--help"], "expect_output": ["--output-format", "--input-format"] }
      ]
    },
    "codex": {
      "required": false,
      "probe": { "kind": "cli", "command": "codex", "version_args": ["--version"], "behavior_args": ["--help"] },
      "platforms": { "macos": "common", "windows": "common", "linux": "common" },
      "capability_probes": [
        { "id": "codex-app-server", "args": ["app-server", "--help"] },
        { "id": "codex-exec-json", "args": ["exec", "--help"], "expect_output": ["--json"] }
      ]
    }
  },
