{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forge:milestone-endpoint:v1",
  "title": "Owner milestone endpoint record v1: .gsd/forge/time/<M>/endpoint.json (verified-integrated-delivery, immutable, public data, at most 64 KiB)",
  "description": "Published once by forge-milestone-endpoint.recordEndpoint inside ownerBoundary through publishOwnerRecord, only when forge-milestone-time-clock.readEndpointProof is proven at endpoint_at. The clock snapshot freezes milestone consumption; elapsed time continues separately. Publication, CI, merge, release, installation and UAT remain separate facts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "milestone", "policy", "endpoint_at", "contract", "completion", "delivery", "selection", "roadmap", "reviews", "roots", "questions", "time_state", "clock"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "forge-milestone-endpoint" },
    "milestone": { "type": "string", "pattern": "^M", "maxLength": 200 },
    "policy": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": { "id": { "const": "forge-milestone-endpoint-proof" }, "version": { "const": 1 } }
    },
    "endpoint_at": { "$ref": "#/$defs/instant", "description": "The injected now of the record; the clock snapshot and time_state use the same instant." },
    "contract": {
      "type": "object", "additionalProperties": false, "required": ["version", "sha256", "base_sha256"],
      "description": "Bound to row version of the current contract chain; later amendments keep the row and never reopen the endpoint.",
      "properties": { "version": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "#/$defs/hash" }, "base_sha256": { "$ref": "#/$defs/hash" } }
    },
    "completion": {
      "type": "object", "additionalProperties": false,
      "required": ["unit", "transaction_sha256", "result_sha256", "boundary_sha256", "event_sha256", "completed_at", "committed_at"],
      "properties": {
        "unit": { "type": "string", "pattern": "^complete-milestone/" },
        "transaction_sha256": { "$ref": "#/$defs/hash" }, "result_sha256": { "$ref": "#/$defs/hash" },
        "boundary_sha256": { "$ref": "#/$defs/hash" }, "event_sha256": { "$ref": "#/$defs/hash" },
        "completed_at": { "$ref": "#/$defs/instant" }, "committed_at": { "$ref": "#/$defs/instant" }
      }
    },
    "delivery": {
      "type": "object", "additionalProperties": false, "required": ["reference", "sha256", "input_sha256", "fingerprint", "criteria", "children"],
      "properties": {
        "reference": { "type": "string", "pattern": "^\\.gsd/milestones/[^/]+/[^/]+-DELIVERY\\.json$" },
        "sha256": { "$ref": "#/$defs/hash" }, "input_sha256": { "$ref": "#/$defs/hash" }, "fingerprint": { "$ref": "#/$defs/hash" },
        "criteria": { "type": "integer", "minimum": 1 },
        "children": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/child" } }
      }
    },
    "selection": {
      "type": "object", "additionalProperties": false, "required": ["status", "sha256"],
      "properties": { "status": { "enum": ["decided", "not-enrolled"] }, "sha256": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] } }
    },
    "roadmap": {
      "type": "object", "additionalProperties": false, "required": ["sha256", "structure_sha256"],
      "properties": { "sha256": { "$ref": "#/$defs/hash" }, "structure_sha256": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] } }
    },
    "reviews": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/review" } },
    "roots": { "type": "array", "minItems": 1, "maxItems": 14, "items": { "$ref": "#/$defs/root" } },
    "questions": {
      "type": "object", "additionalProperties": false, "required": ["pending"],
      "properties": { "pending": { "const": 0 } }
    },
    "time_state": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "contract_version", "ceiling_ms", "consumed_ms", "unknown_ms", "remaining_ms", "forecast", "unknown", "decision_pending"],
      "properties": {
        "state": { "enum": ["active", "warning", "exhausted", "draining", "checkpointed", "extended", null] },
        "contract_version": { "type": "integer", "minimum": 1 },
        "ceiling_ms": { "$ref": "#/$defs/nullableInteger" }, "consumed_ms": { "$ref": "#/$defs/nullableInteger" },
        "unknown_ms": { "$ref": "#/$defs/nullableInteger" }, "remaining_ms": { "$ref": "#/$defs/nullableInteger" },
        "forecast": { "enum": ["fits", "at-risk", "exceeds", "unknown"] },
        "unknown": { "type": "boolean" }, "decision_pending": { "type": "boolean" }
      }
    },
    "clock": {
      "type": "object", "additionalProperties": false,
      "required": ["consumed_ms", "unknown_ms", "by_class", "effort", "waits", "gaps", "gap_count", "gaps_truncated"],
      "properties": {
        "consumed_ms": { "type": "integer", "minimum": 0 }, "unknown_ms": { "type": "integer", "minimum": 0 },
        "by_class": {
          "type": "object", "additionalProperties": false,
          "required": ["unit-work", "owner-session", "human-wait", "pause", "ci-wait", "external-wait", "unknown"],
          "propertyNames": { "enum": ["unit-work", "owner-session", "human-wait", "pause", "ci-wait", "external-wait", "unknown"] },
          "patternProperties": { "": { "type": "integer", "minimum": 0 } }
        },
        "effort": { "type": "object", "required": ["unit_interval_sum_ms"], "description": "Copied as observed by readClock at endpoint_at; owner verification is never worker effort." },
        "waits": {
          "type": "object", "additionalProperties": false, "required": ["human-wait", "pause", "ci-wait", "external-wait"],
          "propertyNames": { "enum": ["human-wait", "pause", "ci-wait", "external-wait"] },
          "patternProperties": { "": { "type": "integer", "minimum": 0 } }
        },
        "gaps": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/gap" } },
        "gap_count": { "type": "integer", "minimum": 0 },
        "gaps_truncated": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "revision": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "instant": { "type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$" },
    "nullableInteger": { "oneOf": [{ "type": "integer" }, { "type": "null" }] },
    "child": {
      "type": "object", "additionalProperties": false, "required": ["unit", "reference", "sha256"],
      "properties": { "unit": { "type": "string", "pattern": "/slice/S\\d{2,}$" }, "reference": { "type": "string" }, "sha256": { "$ref": "#/$defs/hash" } }
    },
    "review": {
      "type": "object", "additionalProperties": false, "required": ["slice", "reference", "sha256"],
      "properties": { "slice": { "type": "string", "pattern": "^S\\d{2,}$" }, "reference": { "type": "string", "pattern": "-REVIEW\\.md$" }, "sha256": { "$ref": "#/$defs/hash" } }
    },
    "root": {
      "type": "object", "additionalProperties": false,
      "required": ["root_id", "root_identity_sha256", "revision", "branch", "envelope_sha256", "checks", "scope"],
      "properties": {
        "root_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
        "root_identity_sha256": { "$ref": "#/$defs/hash" },
        "revision": { "$ref": "#/$defs/revision" },
        "branch": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 255 }, { "type": "null" }] },
        "envelope_sha256": { "$ref": "#/$defs/hash", "description": "sha256 of <M>-ENDPOINT-VERIFICATION-<root>-ENVELOPE.json captured after committed_at." },
        "checks": { "type": "integer", "minimum": 1 },
        "scope": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/scopeEntry" } }
      }
    },
    "scopeEntry": {
      "type": "object", "additionalProperties": false, "required": ["path", "hash"],
      "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 1024 }, "hash": { "$ref": "#/$defs/revision" } }
    },
    "gap": {
      "type": "object", "additionalProperties": false, "required": ["start", "end", "reason"],
      "properties": { "start": { "type": "integer" }, "end": { "type": "integer" }, "reason": { "enum": ["wait-end-missing", "session-change", "source-limit", "no-source"] } }
    }
  }
}
