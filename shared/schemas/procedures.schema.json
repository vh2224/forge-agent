{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Forge mandatory procedure manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "byte_policy",
    "core",
    "modules",
    "phases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "byte_policy": {
      "const": "utf8-no-bom-lf-v1"
    },
    "core": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,95}$"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/phase"
      }
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256",
        "status",
        "owner",
        "dependencies",
        "preconditions",
        "postconditions",
        "tests"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,95}$"
        },
        "path": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^shared\\/(?:[A-Za-z0-9_-]+\\/)*[A-Za-z0-9_-]+\\.md$"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "ready",
            "pending"
          ]
        },
        "owner": {
          "type": "string",
          "pattern": "^T[0-9]{2}$"
        },
        "dependencies": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,95}$"
          }
        },
        "preconditions": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 1
        },
        "postconditions": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 1
        },
        "tests": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ready"
              }
            }
          },
          "then": {
            "properties": {
              "sha256": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "sha256": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "modules",
        "consumers",
        "owner",
        "preconditions",
        "postconditions",
        "tests"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,95}$"
        },
        "modules": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,95}$"
          },
          "minItems": 1
        },
        "consumers": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!\\/)(?!.*(?:\\\\|:|[\\u0000-\\u001f]))(?!(?:.*?\\/)?\\.\\.?(?:\\/|$))[^/]+(?:\\/[^/]+)*$"
          },
          "minItems": 1
        },
        "owner": {
          "type": "string",
          "pattern": "^T[0-9]{2}$"
        },
        "preconditions": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 1
        },
        "postconditions": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 1
        },
        "tests": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 1
        }
      }
    }
  }
}
