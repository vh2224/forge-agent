#!/usr/bin/env bash
# forge-status — thin CLI wrapper over scripts/forge-status.js
#
# Pure pass-through: forge-status.js already accepts flags directly
# (positional <M-id> + --json/--tokens/--watch/--cwd), so there is no
# subcommand syntax to translate — unlike forge-accounts.
#
# Installed to a bin dir on PATH by install.sh. Resolves the engine in
# ${FORGE_HOME:-$HOME/.forge-agent} first, then falls back to the repo
# (repo_path in prefs) for dev/dogfood. Pure-read/zero-token — never
# reprocesses the engine output.
set -euo pipefail

ENGINE="${FORGE_HOME:-$HOME/.forge-agent}/scripts/forge-status.js"
if [ ! -f "$ENGINE" ]; then
  # Read repo_path from the current prefs format (JSONC). Two traps, both real:
  # the scaffold ships a COMMENTED repo_path hundreds of lines above the live
  # one, and the value is a JSON string. So: drop comment lines, keep the LAST
  # live assignment, strip quotes/commas.
  PREFS="${FORGE_HOME:-$HOME/.forge-agent}/shared/forge-agent-prefs.jsonc"
  [ -f "$PREFS" ] || PREFS="${FORGE_HOME:-$HOME/.forge-agent}/shared/forge-agent-prefs.json"
  if [ -f "$PREFS" ]; then
    REPO="$(sed 's/[[:space:]]*\/\/.*$//' "$PREFS" 2>/dev/null \
      | grep -E '^[[:space:]]*"repo_path"[[:space:]]*:' \
      | tail -1 | cut -d: -f2- | tr -d ' ",' || true)"
    [ -n "${REPO:-}" ] && [ -f "$REPO/scripts/forge-status.js" ] && ENGINE="$REPO/scripts/forge-status.js"
  fi
fi
if [ ! -f "$ENGINE" ]; then
  echo "forge-status: engine não encontrado. Rode /forge-update." >&2
  exit 1
fi

exec node "$ENGINE" "$@"
