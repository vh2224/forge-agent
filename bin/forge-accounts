#!/usr/bin/env bash
# forge-accounts — thin CLI wrapper over scripts/forge-accounts.js
#
# Turns subcommand syntax into the engine's flags so users type
#   forge-accounts add trabalho
# instead of
#   node ~/.claude/scripts/forge-accounts.js --add trabalho
#
# Installed to a bin dir on PATH by install.sh. Resolves the engine in ~/.claude
# first, then falls back to the repo (repo_path in prefs) for dev/dogfood.
set -euo pipefail

ENGINE="$HOME/.claude/scripts/forge-accounts.js"
if [ ! -f "$ENGINE" ]; then
  REPO="$(grep 'repo_path:' "$HOME/.claude/forge-agent-prefs.md" 2>/dev/null | cut -d: -f2 | tr -d ' ' || true)"
  [ -n "${REPO:-}" ] && ENGINE="$REPO/scripts/forge-accounts.js"
fi
if [ ! -f "$ENGINE" ]; then
  echo "forge-accounts: engine não encontrado. Rode /forge-update." >&2
  exit 1
fi

sub="${1:-list}"
[ "$#" -gt 0 ] && shift || true

case "$sub" in
  add|use|token|launch-cmd|remove)
    # subcommands that take a positional <name> before any flags
    name="${1:-}"
    if [ -n "$name" ] && [ "${name#-}" = "$name" ]; then
      shift
      exec node "$ENGINE" --"$sub" "$name" "$@"
    fi
    exec node "$ENGINE" --"$sub" "$@"
    ;;
  rename)
    # two positionals: <old> <new>
    old="${1:-}"; new="${2:-}"
    exec node "$ENGINE" --rename "$old" --to "$new"
    ;;
  list|current)
    exec node "$ENGINE" --"$sub" "$@"
    ;;
  help|-h|--help|"")
    exec node "$ENGINE" --help
    ;;
  *)
    # pass through unknown subcommands as a flag (forward-compat)
    exec node "$ENGINE" --"$sub" "$@"
    ;;
esac
