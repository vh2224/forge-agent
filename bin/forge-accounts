#!/usr/bin/env bash
# forge-accounts — thin CLI wrapper over scripts/forge-accounts.js
#
# Turns subcommand syntax into the engine's flags so users type
#   forge-accounts add trabalho
# instead of
#   node ${FORGE_HOME:-$HOME/.forge-agent}/scripts/forge-accounts.js --add trabalho
#
# Installed to a bin dir on PATH by install.sh. Resolves the engine in
# ${FORGE_HOME:-$HOME/.forge-agent} first, then falls back to the repo
# (repo_path in prefs) for dev/dogfood.
set -euo pipefail

ENGINE="${FORGE_HOME:-$HOME/.forge-agent}/scripts/forge-accounts.js"
if [ ! -f "$ENGINE" ]; then
  # Read repo_path from the current prefs format (JSONC): the scaffold ships a
  # COMMENTED repo_path hundreds of lines above the live one, and the value is
  # a JSON string — so drop comments, keep the LAST live assignment, unquote.
  PREFS="${FORGE_HOME:-$HOME/.forge-agent}/shared/forge-agent-prefs.jsonc"
  [ -f "$PREFS" ] || PREFS="${FORGE_HOME:-$HOME/.forge-agent}/shared/forge-agent-prefs.json"
  REPO="$(sed 's/[[:space:]]*\/\/.*$//' "$PREFS" 2>/dev/null \
    | grep -E '^[[:space:]]*"repo_path"[[:space:]]*:' \
    | tail -1 | cut -d: -f2- | tr -d ' ",' || true)"
  [ -n "${REPO:-}" ] && ENGINE="$REPO/scripts/forge-accounts.js"
fi
if [ ! -f "$ENGINE" ]; then
  echo "forge-accounts: engine não encontrado. Rode /forge-update." >&2
  exit 1
fi

sub="${1:-list}"
[ "$#" -gt 0 ] && shift || true

case "$sub" in
  add|use|token|launch-cmd|remove|default|launch|launch-prep)
    # subcommands that take a positional <name> before any flags
    name="${1:-}"
    if [ -n "$name" ] && [ "${name#-}" = "$name" ]; then
      shift
      exec node "$ENGINE" --"$sub" "$name" "$@"
    fi
    exec node "$ENGINE" --"$sub" "$@"
    ;;
  set-email)
    # forms: set-email <name> <email>  |  set-email <name> --email <e> [--uuid <u>]
    name="${1:-}"; shift 2>/dev/null || true
    second="${1:-}"
    if [ -n "$second" ] && [ "${second#-}" = "$second" ]; then
      shift
      exec node "$ENGINE" --set-email "$name" --email "$second" "$@"
    fi
    exec node "$ENGINE" --set-email "$name" "$@"
    ;;
  rename)
    # two positionals: <old> <new>
    old="${1:-}"; new="${2:-}"
    exec node "$ENGINE" --rename "$old" --to "$new"
    ;;
  list|current|shell-init|shell-init-pwsh)
    exec node "$ENGINE" --"$sub" "$@"
    ;;
  help|-h|--help|"")
    exec node "$ENGINE" --help
    ;;
  *)
    # pass through unknown subcommands as a flag (forward-compat)
    exec node "$ENGINE" --"$sub" "$@"
    ;;
esac
