#!/usr/bin/env bash
# forge-secrets — CLI wrapper over scripts/forge-secrets.js
#
# Translates subcommands into flags, like bin/forge-accounts:
#
#   forge-secrets add railway producao          → --add railway producao  (stdin)
#   forge-secrets list [--json]                 → --list
#   forge-secrets exec railway producao -- ...  → --exec railway producao -- ...
#   forge-secrets remove railway producao       → --remove railway producao
#   forge-secrets services                      → --services
#
# The secret is read from stdin, never from an argument:
#   printf %s "$TOKEN" | forge-secrets add railway producao
set -euo pipefail

ENGINE="${FORGE_HOME:-$HOME/.forge-agent}/scripts/forge-secrets.js"
if [ ! -f "$ENGINE" ]; then
  # Current prefs format (JSONC): skip commented lines, take the last live
  # assignment, strip quotes and commas.
  PREFS="${FORGE_HOME:-$HOME/.forge-agent}/shared/forge-agent-prefs.jsonc"
  [ -f "$PREFS" ] || PREFS="${FORGE_HOME:-$HOME/.forge-agent}/shared/forge-agent-prefs.json"
  if [ -f "$PREFS" ]; then
    REPO="$(sed 's/[[:space:]]*\/\/.*$//' "$PREFS" 2>/dev/null \
      | grep -E '^[[:space:]]*"repo_path"[[:space:]]*:' \
      | tail -1 | cut -d: -f2- | tr -d ' ",' || true)"
    [ -n "${REPO:-}" ] && [ -f "$REPO/scripts/forge-secrets.js" ] && ENGINE="$REPO/scripts/forge-secrets.js"
  fi
fi
if [ ! -f "$ENGINE" ]; then
  echo "forge-secrets: engine não encontrado. Rode ./install.sh" >&2
  exit 1
fi

[ $# -eq 0 ] && exec node "$ENGINE" --help

sub="$1"
case "$sub" in
  default)
    shift
    if [ $# -lt 2 ]; then
      echo "forge-secrets: 'default' requer <serviço> <nome>" >&2
      exit 2
    fi
    svc="$1"; name="$2"; shift 2
    exec node "$ENGINE" --default "$svc" "$name" "$@"
    ;;
  add|remove)
    shift
    if [ $# -lt 2 ]; then
      echo "forge-secrets: '$sub' requer <serviço> <nome>" >&2
      exit 2
    fi
    svc="$1"; name="$2"; shift 2
    exec node "$ENGINE" "--$sub" "$svc" "$name" "$@"
    ;;
  exec)
    # Name is optional: `exec railway -- cmd` resolves through the default.
    shift
    if [ $# -lt 2 ]; then
      echo "forge-secrets: 'exec' requer <serviço> [nome] -- <comando>" >&2
      exit 2
    fi
    svc="$1"; shift
    exec node "$ENGINE" --exec "$svc" "$@"
    ;;
  list|services)
    shift
    exec node "$ENGINE" "--$sub" "$@"
    ;;
  -h|--help|help)
    exec node "$ENGINE" --help
    ;;
  --*)
    exec node "$ENGINE" "$@"
    ;;
  *)
    echo "forge-secrets: subcomando desconhecido: $sub" >&2
    echo "  use: add | list | exec | default | remove | services" >&2
    exit 2
    ;;
esac
